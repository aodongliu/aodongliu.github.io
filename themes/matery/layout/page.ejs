<% const statsPage = page.path.replace(/index\.html$/, '').replace(/\/$/, '') === 'strangerStats'; %>
<% if (statsPage) { const series = stats_series(); const sticker = post => post.path === series.newPath ? 'new' : ''; %>
<header class="article-header site-wrap"><h1>Stranger Stats</h1><div class="article-intro stats-intro"><%- page.content %></div><p class="article-meta"><%= series.total %> published stories</p></header>
<% if (series.pinned.length) { %>
<section class="site-wrap sl-list sl-list-pinned" aria-labelledby="pinned-title">
  <h2 id="pinned-title" class="sl-title">Pinned</h2>
  <ol class="sl-rows"><% series.pinned.forEach(function(post) { %><%- partial('_partial/post-row', {post: post, tag: sticker(post), short: true}) %><% }); %></ol>
</section>
<% } %>
<section class="site-wrap sl-list" aria-labelledby="more-title">
  <% if (series.pinned.length) { %><h2 id="more-title" class="sl-title">More posts</h2><% } %>
  <ol class="sl-rows"><% series.rest.forEach(function(post) { %><%- partial('_partial/post-row', {post: post, tag: sticker(post), short: true}) %><% }); %></ol>
</section>
<% } else { %>
<header class="article-header site-wrap"><h1><%= page.title %></h1></header>
<article class="article-body standalone-page site-wrap"><%- page.content %></article>
<% } %>
<% if (page.math || page.mathjax) { %>
<script>window.MathJax = {tex: {inlineMath: [['$', '$'], ['\\(', '\\)']]}, options: {skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code']}};</script>
<script defer src="https://cdn.jsdelivr.net/npm/mathjax@3.2.2/es5/tex-mml-chtml.js"></script>
<% } %>
