<!doctype html>
<html lang="en" data-theme="light">
<%- partial('_partial/portfolio-head') %>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="site-wrap header-inner">
    <a class="brand" href="/" aria-label="Aodong Liu home"><img class="brand-logo-image" src="/images/al_logo.png" width="48" height="48" alt=""><span>Aodong Liu</span></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">Menu <span aria-hidden="true">＋</span></button>
    <nav id="primary-nav" class="primary-nav" aria-label="Main navigation">
      <a href="/research/" <%- page.path && page.path.startsWith('research/') ? 'aria-current="page"' : '' %>>Research</a>
      <a href="/strangerStats/" <%- page.path && page.path.startsWith('strangerStats/') ? 'aria-current="page"' : '' %>>Stranger Stats</a>
      <%# Training is hidden from the nav until the page is ready; restore this link to show it: %>
      <%# <a href="/training/" ...>Training</a> %>
      <a href="/archives/" <%- page.path && /^(archives|tags|categories)\//.test(page.path) ? 'aria-current="page"' : '' %>>Archives</a>
      <a href="/about/" <%- page.path && page.path.startsWith('about/') ? 'aria-current="page"' : '' %>>About</a>
      <a class="nav-cv" href="/cv/">CV </a>
    </nav>
    <button class="search-toggle" type="button" aria-label="Search this site" title="Search (/)" aria-haspopup="dialog" aria-controls="search-dialog"><svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button>
    <button class="theme-toggle" type="button" aria-label="Switch to light theme" title="Switch color theme"><span aria-hidden="true">◐</span></button>
  </div>
</header>
<dialog id="search-dialog" class="search-dialog" aria-labelledby="search-dialog-title">
  <form class="search-dialog-head" method="dialog" role="search">
    <label id="search-dialog-title" for="search-dialog-input">Search</label>
    <input id="search-dialog-input" class="search-input" type="search" autocomplete="off" spellcheck="false" aria-controls="search-dialog-results">
    <button class="search-close" type="button" aria-label="Close search">Esc</button>
  </form>
  <p class="search-status" aria-live="polite"></p>
  <ol id="search-dialog-results" class="search-results"></ol>
</dialog>
<main id="main" class="site-main"><%- body %></main>
<footer class="site-footer site-wrap">
  <nav class="contact-links" aria-label="Contact and profiles"><% (site.data.portfolio.contact_links || []).forEach(link => { %><a href="<%= link.url %>"><%= link.label %></a><% }); %></nav>
  <div class="footer-bottom"><span>© <%= new Date().getFullYear() %> Aodong Liu</span><span>Hexo · Matery</span><a href="#main">Back to top ↑</a></div>
</footer>
<script src="/js/site.js" defer></script>
</body>
</html>
