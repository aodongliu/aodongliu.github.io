<% const tagArr = site.tags.toArray().filter(tag => tag.length); %>
<header class="article-header site-wrap taxonomy-header"><h1>Tags</h1><p class="article-meta"><%= tagArr.length %> tags across <%= site.posts.length %> posts</p><%- partial('_partial/archive-tabs') %></header>
<div class="site-wrap taxonomy-page"><%- partial('_partial/taxonomy-chips', {items: site.tags, active: '', label: 'All tags'}) %></div>
