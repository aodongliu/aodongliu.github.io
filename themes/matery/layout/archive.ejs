<% /* Matery archives: a year of posting activity, then a year/month timeline. */
   const scoped = page.year ? (page.month ? date(new Date(page.year, page.month - 1), 'MMMM YYYY') : String(page.year)) : '';
   const calendar = scoped ? null : post_calendar(site.posts.toArray());
   const groups = [];
   page.posts.each(function(post) {
     const year = date(post.date, 'YYYY'), month = date(post.date, 'MMMM');
     let y = groups[groups.length - 1]; if (!y || y.year !== year) groups.push(y = {year, months: []});
     let m = y.months[y.months.length - 1]; if (!m || m.month !== month) y.months.push(m = {month, posts: []});
     m.posts.push(post);
   }); %>
<header class="article-header site-wrap taxonomy-header"><% if (scoped) { %><a class="eyebrow" href="<%- url_for('/archives/') %>">← All archives</a><% } %><h1><%= scoped ? scoped : 'Archives' %></h1><p class="article-meta"><%= scoped ? page.posts.length : site.posts.length %> posts</p><%- partial('_partial/archive-tabs') %></header>
<div class="site-wrap taxonomy-page">
  <% if (calendar) { %>
  <section class="taxonomy-card post-calendar" aria-labelledby="calendar-title">
    <h2 id="calendar-title" class="chart-title">Post calendar <span><%= calendar.total %> post<%= calendar.total === 1 ? '' : 's' %> in the last year</span></h2>
    <div class="calendar-scroll">
      <div class="calendar" style="--weeks:<%= calendar.weeks.length %>" role="img" aria-label="<%= calendar.total %> posts between <%= calendar.start %> and <%= calendar.end %>. Each post is listed in the timeline below.">
        <div class="calendar-months" aria-hidden="true"><% calendar.months.forEach(function(m) { %><span style="grid-column:<%= m.col + 1 %>"><%= m.label %></span><% }); %></div>
        <div class="calendar-days" aria-hidden="true"><span>Mon</span><span>Wed</span><span>Fri</span></div>
        <div class="calendar-grid"><% calendar.weeks.forEach(function(week) { week.forEach(function(cell) { %><% if (!cell) { %><span class="cell is-future"></span><% } else if (cell.posts.length) { %><a class="cell level-<%= Math.min(cell.posts.length, 2) %>" href="<%- cell.posts[0].path %>" data-tip="<%= cell.date %> · <%= cell.posts.map(p => p.title).join(' / ') %>" aria-label="<%= cell.date %>: <%= cell.posts.map(p => p.title).join(', ') %>"></a><% } else { %><span class="cell" data-tip="<%= cell.date %> · no posts"></span><% } %><% }); }); %></div>
      </div>
    </div>
    <div class="calendar-foot"><p class="calendar-readout" aria-hidden="true">Hover a day to see its posts.</p><p class="calendar-legend" aria-hidden="true"><span>No post</span><span class="cell"></span><span class="cell level-1"></span><span class="cell level-2"></span><span>2+ posts</span></p></div>
  </section>
  <% } %>
  <section class="timeline" aria-label="Posts by date">
    <% groups.forEach(function(y) { %>
    <div class="timeline-year"><h2 class="timeline-node year-node"><%= y.year %></h2>
      <% y.months.forEach(function(m) { %>
      <div class="timeline-month"><h3 class="timeline-node month-node"><%= m.month %></h3>
        <% m.posts.forEach(function(post) { const meta = post_card(post); %>
        <article class="timeline-entry">
          <% if (meta.cover) { %><a class="timeline-thumb" href="<%- url_for(post.path) %>" tabindex="-1" aria-hidden="true"><img src="<%= meta.cover %>" alt="" width="240" height="144" loading="lazy"></a><% } %>
          <div class="timeline-copy">
            <time datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'MMM D, YYYY') %></time>
            <h4><a href="<%- url_for(post.path) %>"><%= post.title %></a></h4>
            <%- partial('_partial/post-chips', {post: post}) %>
          </div>
        </article>
        <% }); %>
      </div>
      <% }); %>
    </div>
    <% }); %>
  </section>
</div>
<% if (page.total > 1) { %><nav class="site-wrap pagination" aria-label="Pagination"><%- paginator({prev_text: '← Previous', next_text: 'Next →'}) %></nav><% } %>
