<% const cats = site.categories.toArray().filter(category => category.length); %>
<header class="article-header site-wrap taxonomy-header"><h1>Categories</h1><p class="article-meta"><%= cats.length %> categories across <%= site.posts.length %> posts</p><%- partial('_partial/archive-tabs') %></header>
<div class="site-wrap taxonomy-page"><%- partial('_partial/taxonomy-chips', {items: site.categories, active: '', label: 'All categories'}) %></div>
