<header class="article-header site-wrap"><p class="eyebrow">Explore the writing</p><h1>Categories</h1></header>
<div class="site-wrap topic-list"><% site.categories.sort('name').each(function(topic) { %><a href="<%- url_for(topic.path) %>"><%= topic.name %><span><%= topic.length %></span></a><% }); %></div>
