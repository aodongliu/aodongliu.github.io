<% const vocab = site.data.keywords || { groups: {} }; const years = [...new Set(page.papers.map(p => p.year))]; %>
<section class="page-intro site-wrap"><h1>Research</h1><p class="intro-description">My research focuses on incorporating nuclear quantum effects into electronic structure theory and on developing scalable algorithms for large-scale quantum dynamics simulations.</p><div class="intro-links"><a class="text-link" href="https://scholar.google.com/citations?user=P6BLL58AAAAJ&amp;hl=en">Google Scholar</a><a class="text-link" href="/cv/">CV</a></div></section>
<section class="site-wrap pub-list" aria-labelledby="pubs-title">
  <div class="pub-list-head"><h2 id="pubs-title">Publications</h2><ul class="kw-legend" aria-label="Keyword colors"><% Object.entries(vocab.groups).forEach(([key, label]) => { %><li class="kw kw-<%= key %>"><%= label %></li><% }); %></ul></div>
  <% years.forEach(year => { %>
  <div class="pub-year">
    <p class="pub-year-label"><%= year %></p>
    <ol class="pub-rows"><% page.papers.filter(p => p.year === year).forEach(paper => { %>
      <li class="pub-row">
        <a class="pub-thumb" href="/research/<%= paper.id %>/" tabindex="-1" aria-hidden="true"><% if (paper.image) { %><img src="<%= paper.image %>" alt="" loading="lazy"><% } %></a>
        <div class="pub-copy">
          <h3><a href="/research/<%= paper.id %>/"><%= paper.title %></a></h3>
          <p class="pub-authors"><%- author_list(paper.authors) %></p>
          <p class="pub-venue"><em><%= paper.venue %></em> <%= paper.citation %></p>
          <%- keyword_pills(paper) %>
          <p class="pub-links"><a href="/research/<%= paper.id %>/">Overview</a><a href="<%= paper.url %>">Paper</a></p>
        </div>
      </li><% }); %>
    </ol>
  </div>
  <% }); %>
</section>
