<% const cleanDescription = strip_html(page.description || page.summary || (page.paper && page.paper.summary) || config.description).slice(0, 220); const canonicalPath = (page.path || '').replace(/index\.html$/, ''); const canonicalUrl = new URL(canonicalPath, config.url).href; %>
<head>
<meta charset="utf-8">
<% if (config.google_site_verification) { %><meta name="google-site-verification" content="<%= config.google_site_verification %>"><% } %>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= page.title ? page.title + ' | ' + config.title : config.title + ' | ' + config.subtitle %></title>
<meta name="description" content="<%= cleanDescription %>">
<% if (config.portfolio_preview) { %><meta name="robots" content="noindex, nofollow"><% } %>
<link rel="canonical" href="<%= canonicalUrl %>">
<meta property="og:title" content="<%= page.title || config.title + ' | ' + config.subtitle %>">
<meta property="og:site_name" content="<%= config.title %>">
<meta property="og:description" content="<%= cleanDescription %>">
<meta property="og:url" content="<%= canonicalUrl %>">
<meta property="og:type" content="<%= page.__post ? 'article' : 'website' %>">
<% const sectionPath = (page.path || '').replace(/index\.html$/, ''); const ogCard = { 'research/': 'research', 'strangerStats/': 'stranger-stats' }[sectionPath] || (!page.cover && !(page.paper && page.paper.image) ? 'home' : ''); const ogImage = ogCard ? `/images/og/${ogCard}.jpg` : (page.cover || page.paper.image); %>
<meta property="og:image" content="<%= new URL(ogImage, config.url).href %>">
<% if (ogCard) { %><meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630"><% } %>
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#fbfefe" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#061417" media="(prefers-color-scheme: dark)">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<% if (!page.path || page.path === 'index.html') { %>
<script type="application/ld+json"><%- JSON.stringify({"@context":"https://schema.org","@type":"WebSite",name:config.title,url:config.url}).replace(/</g, '\\u003c') %></script>
<% } %>
<script>(() => { let mode = null; try { mode = localStorage.getItem('aodong-theme-v2'); } catch (_) {} if (mode !== 'light' && mode !== 'dark') mode = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; document.documentElement.dataset.theme = mode; })();</script>
<link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/site.css">
<link rel="stylesheet" href="/css/article.css">
</head>
