<% const paper = page.paper; %>
<article class="paper-page site-wrap"><a class="back-link" href="/research/">← All research</a><header class="paper-header"><p class="eyebrow"><%= paper.topic %> / <%= paper.year %></p><h1><%= paper.headline %></h1><p class="paper-summary"><%= paper.summary %></p></header><div class="paper-layout"><% if (paper.image) { %><figure class="paper-figure publication-figure"><a class="paper-image-link" href="<%= paper.image %>" aria-label="View full-size image for <%= paper.title %>"><img src="<%= paper.image %>" alt="<%= paper.image_alt || 'Graphical abstract' %>"></a></figure><% } %><section class="paper-citation" aria-labelledby="publication-heading"><p class="eyebrow" id="publication-heading">Publication</p><h2><%= paper.title %></h2><p class="paper-authors"><%= paper.authors %></p><p><em><%= paper.venue %></em><br><%= paper.citation || '' %> (<%= paper.year %>)</p><% if (paper.authorship_note) { %><p><%= paper.authorship_note %></p><% } %><a class="button button-primary" href="<%= paper.url %>">Read the published paper</a><p class="doi">DOI: <%= paper.doi %></p></section></div>
<% if (paper.abstract) { %>
<section class="paper-abstract article-body" aria-labelledby="abstract-heading">
  <h2 id="abstract-heading">Abstract</h2>
  <% paper.abstract.split(/\n\s*\n/).forEach(paragraph => { %><p><%= paragraph %></p><% }); %>
</section>
<% } %>
</article>
<% if (paper.abstract) { %>
<script>window.MathJax = {tex: {inlineMath: [['$', '$'], ['\\(', '\\)']], displayMath: [['$$', '$$'], ['\\[', '\\]']]}, options: {skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code']}};</script>
<script defer src="https://cdn.jsdelivr.net/npm/mathjax@3.2.2/es5/tex-mml-chtml.js"></script>
<% } %>
